APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Bogota
# Solo si se despliega detrás de un proxy o balanceador: "*" o IPs separadas por coma.
# TRUSTED_PROXIES=

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Correo de FONCALDAS (avisos a asociados y funcionarios) ---
# Con MAIL_MAILER=log los correos solo se escriben en storage/logs (útil en desarrollo).
# Para enviarlos de verdad: cambiar MAIL_MAILER a smtp y completar los datos de la cuenta que enviará los correos.
# Si es Gmail, usar una "contraseña de aplicación" (requiere verificación en dos pasos).
# Después de editar el .env ejecutar: php artisan config:clear
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=correo-de-foncaldas@ejemplo.co
MAIL_PASSWORD=contraseña-de-aplicacion
MAIL_FROM_ADDRESS=correo-de-foncaldas@ejemplo.co
MAIL_FROM_NAME="FONCALDAS"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Correo real del administrador principal: recibe todos los avisos del sistema.
ADMIN_EMAIL=

# --- Producción: valores recomendados antes de publicar ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://tu-dominio-real.co
# SESSION_SECURE_COOKIE=true
# SESSION_ENCRYPT=true
